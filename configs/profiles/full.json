    "allow_unvalidated_ddp": false
  },
  "search_policy": {
    "data_role": "development_only",
    "search_space": null,
    "max_trials_per_method": null,
    "confirmation_set_required": true,
    "allow_test_driven_search": false
  },
  "physical_policy": {
    "required_factors": ["device", "pose", "distance", "illumination", "placement"],
    "consent_reference": null,
    "capture_manifest": null,
    "human_execution_required": true
  },
  "completion_policy": {
    "negative_results_are_valid": true,
    "blocked_is_not_complete": true,
    "cancelled_scope_is_not_original_full_complete": true
  }
